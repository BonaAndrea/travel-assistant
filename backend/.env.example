# Database (Postgres via docker-compose)
DATABASE_URL="postgresql://travel:travel@localhost:5432/travel_assistant?schema=public"

# Auth
JWT_SECRET="dev-only-change-this-secret-to-at-least-32-chars"
FRONTEND_ORIGIN="http://localhost:8080"
METRICS_TOKEN=""
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_IP_MAX=100
AUTH_RATE_LIMIT_ACCOUNT_MAX=10
CONVERSATION_LOCK_TIMEOUT_MS=10000

# Cache locale delle ricerche (TTL breve; usare uno store condiviso per multi-replica)
SEARCH_CACHE_TTL_MS=15000
SEARCH_CACHE_MAX_ENTRIES=500

# Immagini preferenze utente (directory privata, non servita da Express)
USER_PREFERENCE_IMAGE_DIR="./uploads/user-preferences"

# LLM - Groq (gratuito: https://console.groq.com)
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_TIMEOUT_MS="10000"
GROQ_VISION_ENABLED="false"
GROQ_VISION_FREE_TIER_CONFIRMED="false"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"
GROQ_VISION_TIMEOUT_MS="15000"
GROQ_VISION_MAX_RETRIES="1"
GROQ_CHAT_VISION_MAX_RETRIES="1"
GEMINI_ENABLED="false"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_FREE_TIER_CONFIRMED="false"
GEMINI_VISION_ENABLED="false"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_TIMEOUT_MS="10000"
GEMINI_MAX_RETRIES="1"
LLM_MAX_RETRIES="2"
LLM_RETRY_BASE_DELAY_MS="250"
LLM_RETRY_MAX_DELAY_MS="2000"
LLM_CIRCUIT_FAILURE_THRESHOLD="3"
LLM_CIRCUIT_COOLDOWN_MS="30000"

PORT=4000
JSON_BODY_LIMIT="1mb"
