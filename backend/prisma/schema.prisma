generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Utenti ----------
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  conversations Conversation[]
  itineraries   Itinerary[]
  bookings      Booking[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId, expiresAt])
}

// ---------- Aeroporti e destinazioni ----------
model Destination {
  id         String     @id @default(uuid())
  country    String
  city       String
  airports   Airport[]
  hotels     Hotel[]
  activities Activity[]

  @@unique([country, city])
  @@index([country])
}

model Airport {
  id              String       @id @default(uuid())
  iataCode        String       @unique
  name            String
  city            String
  countryCode     String
  destinationId   String?
  destination     Destination? @relation(fields: [destinationId], references: [id])
  outboundFlights Flight[]     @relation("FlightOrigin")
  inboundFlights  Flight[]     @relation("FlightDestination")

  @@index([destinationId])
}

// ---------- Voli ----------
model Flight {
  id                   String   @id @default(uuid())
  originAirportId      String
  destinationAirportId String
  originAirport        Airport  @relation("FlightOrigin", fields: [originAirportId], references: [id])
  destinationAirport   Airport  @relation("FlightDestination", fields: [destinationAirportId], references: [id])
  date                 DateTime
  direction            String // "outbound" | "return"
  seatsAvailable       Int
  cost                 Float
  version              Int      @default(0) // optimistic locking per concorrenza

  @@index([originAirportId, destinationAirportId, date])
}

// ---------- Alberghi ----------
model Hotel {
  id            String              @id @default(uuid())
  name          String
  destinationId String
  destination   Destination         @relation(fields: [destinationId], references: [id])
  country       String
  city          String
  description   String              @default("")
  target        String              @default("") // es. "famiglie, giovani"
  rooms         HotelAvailability[]
}

model HotelAvailability {
  id             String   @id @default(uuid())
  hotelId        String
  hotel          Hotel    @relation(fields: [hotelId], references: [id])
  date           DateTime
  pricePerNight  Float
  roomsAvailable Int
  version        Int      @default(0)

  @@unique([hotelId, date])
}

// ---------- Attivita ----------
model Activity {
  id            String                 @id @default(uuid())
  name          String
  destinationId String
  destination   Destination            @relation(fields: [destinationId], references: [id])
  country       String
  city          String
  category      String // cultura, sport, relax, nightlife...
  description   String                 @default("")
  target        String                 @default("")
  slots         ActivityAvailability[]
}

model ActivityAvailability {
  id         String   @id @default(uuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])
  date       DateTime
  cost       Float
  capacity   Int
  booked     Int      @default(0)
  version    Int      @default(0)

  @@unique([activityId, date])
}

// ---------- Itinerari ----------
model Itinerary {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status       String    @default("draft") // draft | confirmed | expired
  details      Json // snapshot: flights, hotel nights, activities scelte
  totalCost    Float
  flightCost   Float
  hotelCost    Float
  activityCost Float
  compromises  Json? // lista di compromessi applicati, se presenti
  createdAt    DateTime  @default(now())
  bookings     Booking[]

  @@index([conversationId])
}

// ---------- Prenotazioni ----------
model Booking {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  itineraryId        String
  itinerary          Itinerary @relation(fields: [itineraryId], references: [id])
  status             String    @default("pending") // pending | confirmed | failed | cancelled
  idempotencyKey     String    @unique // previene doppie prenotazioni sulla stessa richiesta
  failureReason      String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime  @default(now())
}

// ---------- Conversazioni ----------
model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  state     Json // requisiti raccolti finora + fase corrente
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  itineraries Itinerary[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String // user | assistant | system
  content        String
  createdAt      DateTime     @default(now())
}
